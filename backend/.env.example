# Copy to `.env` and adjust. All values below are the defaults unless noted.
# Lists are JSON arrays.

# dev | prod. prod refuses to start with the default SECRET_KEY, console e-mail or insecure cookies.
ENV=dev
# Used to hash OTP codes. prod: at least 32 random chars, e.g. `openssl rand -hex 32`.
SECRET_KEY=dev-insecure-secret-key-change-me

# --- Storage ---
# Uploads, outputs and the SQLite database live here.
DATA_DIR=./data
# Empty -> sqlite:///<DATA_DIR>/app.db
DATABASE_URL=
# /api/health reports "degraded" when free space in DATA_DIR drops below this (bytes, 1 GB)
MIN_FREE_DISK_BYTES=1073741824

# --- Upload / conversion limits ---
# 250 MB in bytes
MAX_FILE_SIZE=262144000
MAX_FILES_PER_JOB=2
# How long converted files can be downloaded (seconds)
OUTPUT_RETENTION_SECONDS=86400

# --- Conversion engine ---
# Jobs converted in parallel (each runs FFmpeg/Pillow in its own thread)
WORKER_COUNT=2
# A single file conversion is killed after this many seconds
CONVERSION_TIMEOUT_SECONDS=600
# Upload content check (ffprobe) timeout per file
PROBE_TIMEOUT_SECONDS=30
# How often expired outputs and orphaned uploads are deleted (seconds)
CLEANUP_INTERVAL_SECONDS=600
# Upload directories with no running job are removed after this many seconds
STALE_UPLOAD_SECONDS=3600
# Images with more pixels are rejected as corrupted (decompression-bomb protection)
MAX_IMAGE_PIXELS=100000000
# Binaries; set a full path if they are not on PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Concurrent users ---
MAX_ACTIVE_USERS=10
# A user counts as active if they made a request within this window (seconds)
ACTIVE_WINDOW_SECONDS=900

# --- One-time passwords ---
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- Sessions ---
SESSION_TTL_SECONDS=86400
# Default true. Set false for local http development (Safari drops Secure cookies on http://localhost).
COOKIE_SECURE=false

# --- HTTP ---
CORS_ORIGINS=["http://localhost:5173"]

# --- E-mail ---
# console: OTP codes are printed to the server log (dev). smtp: real e-mails (required in prod).
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587) | tls (implicit TLS, port 465) | none (local test servers like Mailpit only; rejected in prod)
SMTP_TLS=starttls
SMTP_TIMEOUT_SECONDS=10
# Restrict login to these domains, e.g. ["agh.edu.pl"]. Empty -> any domain.
ALLOWED_EMAIL_DOMAINS=[]
