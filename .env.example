# Settings for `docker compose` (compose.yaml). Copy to `.env` next to compose.yaml.

# --- Where the app lives ---
# Public host name; Traefik serves https://DOMAIN (frontend) and https://DOMAIN/api (backend).
DOMAIN=konwus.example.com

# --- Your Traefik ---
# Docker network Traefik is attached to (must already exist).
TRAEFIK_NETWORK=traefik
# Name of Traefik's HTTPS entrypoint and certificate resolver.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Secrets ---
# At least 32 random characters: `openssl rand -hex 32`
SECRET_KEY=

# --- E-mail with login codes (required in production) ---
SMTP_HOST=
# 587 + starttls, or 465 + tls
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. no-reply@example.com
SMTP_FROM=

# --- Optional ---
# Only these e-mail domains may log in, JSON list, e.g. ["agh.edu.pl"]. [] = any.
ALLOWED_EMAIL_DOMAINS=[]
MAX_ACTIVE_USERS=10
# Conversions running in parallel (each uses FFmpeg; size to the server's CPUs).
WORKER_COUNT=2
